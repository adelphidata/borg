# Build artifacts
/target
node_modules/
dist-electron/
release/
*.tsbuildinfo
apps/*/dist/

# OS files
.DS_Store
Thumbs.db
*.swp
*~

# Editor/IDE
.vscode/
.idea/
*.sublime-*
.vim/

# Secrets
.env
.env.*
!.env.example

# Logs
*.log

# Reference implementations (local only)
/reference

# Internal specs (local only)
/docs/specs/
/docs/spec/

# Live regression log (local only — surfaced from external eval suite)
issues/

# local hooks
/.claude/hooks/
/.claude/
/.agents/
# ...except the checked-in build-cache hook. Re-listing each level is required:
# git will not descend into an ignored directory to find a negation.
!/.claude/
/.claude/*
!/.claude/hooks/
/.claude/hooks/*
!/.claude/hooks/clean-worktree-target.py

# Local scratch scripts (one-off maintenance tooling)
/scripts/scratch/

# Stray test artifacts (e.g. legacy apply_patch tests that wrote to CWD)
borg_*.txt

# Playwright MCP session artifacts (local only)
/.playwright-mcp/

# Local scratch list of deferred work (not a roadmap)
/TODO.md

# Vitest coverage reports (cargo-llvm-cov writes under target/)
coverage/

# cargo-mutants output
mutants.out/
mutants.out.old/

# StrykerJS mutation-testing artifacts
.stryker-tmp/
**/reports/mutation/
stryker-setup-*.js

# The daemon binary copied in by `just desktop-bundle-borgd`; built, not tracked.
apps/desktop/resources/bin/borgd
apps/desktop/resources/bin/borgd.exe

# Local UI screenshots for review (not tracked)
/screenshots/
/output/*
