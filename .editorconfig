root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[Justfile]
indent_style = space
indent_size = 4

# Web surfaces (apps/, packages/) follow JS/TS convention, not the Rust default above.
[*.{ts,tsx,js,jsx,mjs,json,css,html}]
indent_size = 2
