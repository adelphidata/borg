{
  "name": "@borg/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop client for Borg — your personal assistant, employee, developer, analyst, and sidekick",
  "license": "MIT",
  "author": "Adelphi Data, Inc.",
  "homepage": "https://github.com/adelphidata/borg",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "bun run build:electron && concurrently -k \"vite\" \"bun run dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "bun build ./electron/main.ts ./electron/preload.ts --outdir dist-electron --target node --format cjs --external electron",
    "build": "vite build && bun run build:electron",
    "start": "bun run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "bun run build && electron-builder --config electron-builder.yml",
    "pack": "bun run build && electron-builder --config electron-builder.yml --dir"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@borg/app": "workspace:*",
    "@borg/client": "workspace:*",
    "@borg/ui": "workspace:*",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  }
}
