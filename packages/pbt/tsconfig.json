{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // The extras module is not in the package's export map; point at its
    // types wherever the package manager put the package (this workspace's
    // node_modules, else the hoisted root one).
    "paths": {
      "@antithesishq/bombadil/browser/extras/resources": [
        "./node_modules/@antithesishq/bombadil/dist/browser/extras/resources.d.ts",
        "../../node_modules/@antithesishq/bombadil/dist/browser/extras/resources.d.ts"
      ]
    }
  },
  "include": ["spec"]
}
