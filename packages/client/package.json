{
  "name": "@borg/client",
  "version": "0.3.2",
  "private": true,
  "description": "Generated gRPC client for borgd — one typed API, node (UDS) and browser (gRPC-Web) transports",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./web": "./src/web.ts"
