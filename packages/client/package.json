    "@grpc/grpc-js": "^1.14.6",
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.4",
    "nice-grpc-web": "^3.3.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
