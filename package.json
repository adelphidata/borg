{
  "name": "borgbase",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop client for Borg — your personal assistant, employee, developer, analyst, and sidekick",
  "license": "MIT",
  "author": "Borg Contributors",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "bun run build:electron && concurrently -k \"vite\" \"bun run dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "bun build ./electron/main.ts ./electron/preload.ts --outdir dist-electron --target node --format cjs --external electron",
    "build": "vite build && bun run build:electron",
    "start": "bun run build && electron .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,html}": "prettier --write"
  },
  "trustedDependencies": [
    "electron"
  ],
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  }
}
